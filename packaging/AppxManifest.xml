<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest of the Microsoft Store build. scripts/pack-msix.ps1 fills the $...$ tokens:
  for a Store submission, IdentityName / Publisher / PublisherDisplayName must be copied from
  Partner Center (Product identity page) once the app name is reserved.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeskToggle</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="DeskToggle" Executable="DesktopIconsToggle.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeskToggle"
        Description="Masque les icônes du bureau et la barre des tâches d'un seul raccourci."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Opt-in from the tray menu (StartupTaskAutostart.TaskId); disabled at install. -->
        <desktop:Extension Category="windows.startupTask" Executable="DesktopIconsToggle.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeskToggleStartup" Enabled="false" DisplayName="DeskToggle" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
